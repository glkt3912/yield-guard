# 依存パッケージ（場所を問わず）
node_modules/

frontend/.next

# PDF エクスポートの動作確認生成物（リポジトリ直下のみ）
/*.pdf

# PWA ビルド生成物（Workbox自動生成ファイル）
frontend/public/workbox-*.js
frontend/public/workbox-*.js.map
frontend/public/swe-worker-*.js
frontend/public/swe-worker-*.js.map

# 環境変数（APIキー等を含むためgit管理外）
.env


# Claude Code 内部ファイル
.claude/
backend/.claude/
frontend/.claude/

# TypeScript ビルドキャッシュ
frontend/tsconfig.tsbuildinfo

# OpenAPI 生成ファイル（Node.js バージョン差で内容が変わるため git 管理外）
# 再生成: make swagger && cd frontend && npm run generate:types
docs/openapi/openapi.json
frontend/src/types/api.generated.ts

# Vitest カバレッジレポート
frontend/coverage/

# Playwright
frontend/playwright-report/
frontend/test-results/

# Terraform
terraform/.terraform/
terraform/terraform.tfvars
terraform/terraform.stg.tfvars
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/tfplan
