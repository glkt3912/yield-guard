{
  "name": "yield-guard-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.mjs\"",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit && tsc --noEmit -p worker",
    "pretype-check": "test -f src/types/api.generated.ts || npm run generate:types",
    "generate:types": "swagger2openapi ../docs/openapi/swagger.json --outfile ../docs/openapi/openapi.json && openapi-typescript ../docs/openapi/openapi.json -o src/types/api.generated.ts",
    "pretest": "test -f src/types/api.generated.ts || npm run generate:types",
    "prebuild": "test -f src/types/api.generated.ts || npm run generate:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --reporter=list",
    "e2e:ci": "playwright test --reporter=list,html",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.62.0",
    "pdfmake": "^0.3.13",
    "react": "^19",
    "react-dom": "^19",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
