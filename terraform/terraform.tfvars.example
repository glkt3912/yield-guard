# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is excluded from git (see .gitignore).
#
# --- Staging environment ---
# For stg, use a separate backend config:
#   terraform init -backend-config=backend-stg.hcl -reconfigure
#   terraform apply -var-file=terraform.stg.tfvars
#
# After stg terraform apply, register in GitHub:
#   Secrets: WIF_PROVIDER_STG, SA_EMAIL_STG
#   Vercel project → Environment Variables → Preview: BACKEND_URL = <stg Cloud Run URL>
#
# --- After terraform apply, register the following in GitHub (prod):
#
# GitHub Secrets（Settings → Secrets and variables → Actions → Secrets）:
#   WIF_PROVIDER              = terraform output -raw wif_provider
#   SA_EMAIL                  = terraform output -raw sa_email
#   GCP_PROJECT_ID            = var.project_id
#   MLIT_API_KEY              = MLIT API キー（backend-ci の integration テスト用）
#
# GitHub Variables（Settings → Secrets and variables → Actions → Variables）:
#   VERCEL_FRONTEND_URL       = var.vercel_frontend_url
#   ENABLE_GEMINI_SUMMARY     = true（gemini-api-key-prod にバージョンを投入済みの場合のみ）
#
# --- Secret values ---
# API キー（MLIT / app-internal / Gemini）の値は tfstate に平文で残るため Terraform では扱わない。
# terraform apply でシークレットの入れ物を作成した後、gcloud で値を投入する（docs/security.md 参照）:
#   echo -n "<value>" | gcloud secrets versions add mlit-api-key-prod --data-file=-
#   echo -n "<value>" | gcloud secrets versions add app-internal-api-key-prod --data-file=-
#   echo -n "<value>" | gcloud secrets versions add gemini-api-key-prod --data-file=-   # 任意
#
# --- Remote State (GCS backend) ---
#
# GCS bucket は Terraform 管理外（鶏と卵問題のため手動作成）:
#   gcloud storage buckets create gs://<project_id>-tfstate \
#     --location=asia-northeast1 \
#     --uniform-bucket-level-access
#
# 作成後、main.tf の backend "gcs" ブロックのコメントを外して terraform init を実行する。
#   terraform init  # "Do you want to copy existing state to the new backend?" → yes

project_id            = "your-gcp-project-id"
region                = "asia-northeast1"
env                   = "prod"
enable_gemini_summary = false  # true にする前に gemini-api-key-prod へ値を投入すること（未投入だと Cloud Run が起動しない）
vercel_frontend_url   = "https://your-app.vercel.app"
notification_email    = "your@email.com"
billing_account_id    = "XXXXXX-XXXXXX-XXXXXX"  # gcloud billing accounts list で確認
